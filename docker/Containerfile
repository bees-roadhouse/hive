# syntax=docker/dockerfile:1

# ---- build: install deps + build the web SPA ----
FROM node:22-bookworm-slim AS build
RUN corepack enable && apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# Manifests first so `pnpm install` is layer-cached unless deps change.
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/shared/package.json  ./packages/shared/
COPY packages/api/package.json     ./packages/api/
COPY packages/web/package.json     ./packages/web/
COPY packages/cli/package.json     ./packages/cli/
COPY packages/worker/package.json  ./packages/worker/
RUN pnpm install --frozen-lockfile

# Source, then build shared types + the static SPA.
COPY . .
RUN pnpm --filter @hive/shared build && pnpm --filter @hive/web build

# ---- runtime: api + worker (Node strip-types, no build step at run) ----
FROM node:22-bookworm-slim AS runtime
RUN corepack enable
WORKDIR /app
COPY --from=build /app ./
ENV NODE_ENV=production PORT=8787 HIVE_DB=/data/hive.db HIVE_EMBED=hash
RUN mkdir -p /data
EXPOSE 8787
# Overridden per-service in compose (api vs worker).
CMD ["node", "--experimental-strip-types", "packages/api/src/server.ts"]

# ---- web: static SPA behind Caddy (serves /, proxies /api + /mcp to api) ----
FROM caddy:2-alpine AS web
COPY docker/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/packages/web/dist /srv
EXPOSE 8080
