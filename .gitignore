.vscode/
.idea/
*.swp
.DS_Store

# Rust
target/
**/target/

# Node / Solid app
node_modules/
**/node_modules/
packages/*/dist/
data/*.db
data/*.db-shm
data/*.db-wal
# Artifact bytes: the default data root is ./data, so a local dev upload lands
# here (core/src/artifact_storage.rs).
data/artifacts/
*.tsbuildinfo

# agent worktrees (managed by the Agent tool)
.claude/worktrees/

# `/node/` is deliberately NOT ignored. The rule that once hid it was left over
# from an old Node layout, and a bare `node/` entry would silently hide a whole
# crate if one is ever added back. `node_modules/` above covers the real case.
hive.local.env
