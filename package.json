{
  "name": "hive",
  "private": true,
  "version": "0.7.0",
  "description": "Rust + Solid.js shared AI workspace for journal memory, MCP, tasks, search, and agent integrations.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:api": "cargo run -p hive-api",
    "dev:web": "pnpm --filter @hive/web dev",
    "build": "pnpm --filter @hive/shared build && pnpm --filter @hive/web build",
    "typecheck": "pnpm --filter @hive/web typecheck"
  },
  "packageManager": "pnpm@11.5.0"
}
